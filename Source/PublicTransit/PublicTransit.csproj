<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PublicTransit</AssemblyName>
    <RootNamespace>PublicTransit</RootNamespace>
    <OutputType>Library</OutputType>
    <OutputPath>../../1.6/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- RimWorld game assemblies are NOT committed to Git. This NuGet package is references only. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <!-- Compile against Harmony; the Harmony mod supplies 0Harmony.dll at runtime. -->
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.3" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
